<?xml version="1.0" encoding="utf-8"?><!--
    Everything Firebase-related, kept out of the shared manifest so the FOSS build declares nothing
    Google-related at all — not even the AD_ID removal directive, which would otherwise leave a
    `com.google.android.gms` reference in a manifest an F-Droid reviewer reads.

    The collection switches come from the build type: true only in release.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application>

        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsEnabled}" />
        <meta-data
            android:name="firebase_performance_collection_enabled"
            android:value="${performanceEnabled}" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${crashlyticsEnabled}" />

    </application>

</manifest>
